{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "sales_garut.db",
          "backend/public/**",
          "backend/src/db/schema.sql",
          "TARGET KUANTITI SALES.xlsx"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/src/server.js"
    }
  ]
}
